{
  "name": "gauntlet-game-studio",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/blackwater-relay"
  ],
  "scripts": {
    "check": "bun run --filter '*' check",
    "test": "bun test",
    "lint": "bun run check-topology",
    "validate-agent-artifacts": "python3 scripts/check-traceability.py && python3 scripts/check-topology.py",
    "studio": "bun run ./apps/studio-cli/src/index.ts",
    "test:generated-game": "bun test packages/studio/src/generator.test.ts",
    "test:blackwater-multiplayer": "bun run --cwd examples/blackwater-relay test:blackwater-multiplayer",
    "source:verify": "bun run ./scripts/verify-source.ts",
    "third-party:verify": "bun run ./scripts/verify-third-party.ts",
    "donor:audit": "bun run ./scripts/donor-audit.ts",
    "donor:dependency-scan": "bun run ./scripts/donor-dependency-scan.ts",
    "runtime:headless-smoke": "bun run ./packages/runtime/src/headless-smoke.ts",
    "network:headless-smoke": "bun run ./packages/runtime/src/network/headless-smoke.ts",
    "test:production-observability": "bun run ./packages/runtime/src/observability/production-check.ts",
    "test:audio-browser": "bun run ./packages/adapters/test/audio-browser/run.ts",
    "test:proof-harness": "bun test packages/studio/test/proof && bun run ./packages/studio/test/proof/run-browser-proof.ts",
    "test:performance-fixtures": "bun test packages/studio/test/performance && bun run ./packages/studio/test/performance/run-performance-proof.ts",
    "test:blender-absent-build": "bun run ./packages/adapters/test/blender/blender-absent-build.ts",
    "conformance:recovery": "bun run ./scripts/conformance-recovery.ts",
    "conformance:security": "bun run ./scripts/conformance-security.ts",
    "conformance:clean-checkout": "bun run ./scripts/conformance-clean-checkout.ts"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.3"
  }
}
